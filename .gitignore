# Sessions and dumps are the tool's output, not its source.
logs/
crash_logs/

# Profiles for your own games: they load exactly like the shipped ones but
# belong to you, not to the repo.
profiles/*.local.json

# Per-machine settings: console IP, theme, ports.
voidbuster.json
wiiulog.json

# Dear ImGui window layout, written next to whatever ran.
*.ini

# PyInstaller output.
build/
dist/

__pycache__/
*.py[cod]
